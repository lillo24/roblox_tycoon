				<Item class="ModuleScript" referent="RBX2B47B034BA1F4AE781E298D5194F0544">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local function getPlayerFromSeat(seat: Seat): Player?
	local humanoid = seat.Occupant
	if not humanoid then
		return nil
	end

	local character = humanoid.Parent
	return Players:GetPlayerFromCharacter(character)
end

return getPlayerFromSeat
]]></ProtectedString>
