      <Item class="ModuleScript" referent="CODE_ServerScriptService_8">
        <Properties>
          <string name="Name">MapLayout</string>
          <string name="Source">--!strict

-- Reads the authored map and validates it before gameplay writes any Instances.
local Config = require(game:GetService("ReplicatedStorage").TycoonShared.Config)
local MapLayout = {}
export type Lot = { frame: CFrame, foundation: Part, entrance: Part, accent: Color3 }
export type Layout = { root: Model, lots: { Lot }, cache: Part, plaza: Part, spawn: SpawnLocation }

local function unique(parent: Instance, name: string): Instance
	local matches = {}
	for _, child in parent:GetChildren() do
		if child.Name == name then
			table.insert(matches, child)
		end
	end
	assert(#matches == 1, `Factory hub: {parent:GetFullName()}/{name} expected once, found {#matches}`)
	return matches[1]
end

local function part(parent: Instance, name: string): Part
	local found = unique(parent, name)
	assert(found:IsA("Part") and found.Anchored, `Factory hub: {found:GetFullName()} must be an anchored Part`)
	return found
end

local function corners(lot: Lot): { Vector3 }
	local points: { Vector3 } = {}
	for _, offset in { Vector3.new(-1, 0, -1), Vector3.new(1, 0, -1), Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1) } do
		local size = lot.foundation.Size
		local point = lot.frame:PointToWorldSpace(Vector3.new(offset.X * size.X / 2, 0, offset.Z * size.Z / 2))
		table.insert(points, point)
	end
	return points
end

local function pointSegment(p: Vector3, a: Vector3, b: Vector3): number
	local edge = b - a
	local t = math.clamp((p - a):Dot(edge) / edge:Dot(edge), 0, 1)
	return (p - (a + edge * t)).Magnitude
end

-- SAT catches intersecting oriented rectangles; segment distances measure the gap.
function MapLayout.gap(a: Lot, b: Lot): number
	local ac, bc = corners(a), corners(b)
	local separated = false
	for _, axis in { a.frame.RightVector, a.frame.LookVector, b.frame.RightVector, b.frame.LookVector } do
		local amin, amax, bmin, bmax = math.huge, -math.huge, math.huge, -math.huge
		for _, p in ac do
			amin = math.min(amin, p:Dot(axis))
			amax = math.max(amax, p:Dot(axis))
		end
		for _, p in bc do
			bmin = math.min(bmin, p:Dot(axis))
			bmax = math.max(bmax, p:Dot(axis))
		end
		if amax &lt; bmin or bmax &lt; amin then
			separated = true
		end
	end
	if not separated then
		return 0
	end
	local minimum = math.huge
	for i = 1, 4 do
		for j = 1, 4 do
			minimum =
				math.min(minimum, pointSegment(ac[i], bc[j], bc[j % 4 + 1]), pointSegment(bc[i], ac[j], ac[j % 4 + 1]))
		end
	end
	return minimum
end

-- Support rays include exactly the intended support. Clearance considers every
-- collidable authored part except that support, never an entire map exclusion.
function MapLayout.clear(frame: CFrame, size: Vector3, support: Part, context: string)
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Include
	ray.FilterDescendantsInstances = { support }
	for x = -1, 1 do
		for z = -1, 1 do
			local p = frame:PointToWorldSpace(Vector3.new(x * size.X / 2, 0, z * size.Z / 2))
			local hit = workspace:Raycast(p + Vector3.new(0, 10, 0), Vector3.new(0, -12, 0), ray)
			assert(
				hit and math.abs(hit.Position.Y - frame.Position.Y) &lt; 0.05,
				`Factory hub: {context} lacks level support on {support:GetFullName()}`
			)
		end
	end
	for _, obstacle in workspace:GetPartBoundsInBox(frame * CFrame.new(0, size.Y / 2 + 0.05, 0), size) do
		assert(
			obstacle == support or not obstacle.CanCollide,
			`Factory hub: {context} blocked by {obstacle:GetFullName()}`
		)
	end
end

function MapLayout.inspect(): Layout
	local root = unique(workspace, Config.MapName)
	assert(root:IsA("Model"), "Factory hub: root must be a Model")
	local lotsFolder = unique(root, "Lots")
	assert(#lotsFolder:GetChildren() == Config.PlotCount, `Factory hub: expected {Config.PlotCount} authored lots`)
	local plaza = part(root, "Plaza")
	local cache = part(root, "CacheAnchor")
	assert(
		not cache.CanCollide and cache.Transparency == 1,
		"Factory hub: CacheAnchor must be invisible and noncolliding"
	)
	local spawns: { SpawnLocation } = {}
	for _, i in workspace:GetDescendants() do
		if i:IsA("SpawnLocation") then
			table.insert(spawns, i)
		end
	end
	assert(#spawns == 1 and spawns[1]:IsDescendantOf(root), "Factory hub: expected one hub SpawnLocation")
	local spawn = spawns[1]
	assert((spawn.Position - cache.Position).Magnitude &gt; 10, "Factory hub: spawn overlaps cache approach")
	MapLayout.clear(cache.CFrame, Vector3.new(6, 7, 6), plaza, "cache approach")
	local lots: { Lot } = {}
	for id = 1, Config.PlotCount do
		local model = unique(lotsFolder, `Lot{id}`)
		assert(model:IsA("Model") and model:GetAttribute("LotId") == id, `Factory hub: Lot{id} has wrong stable LotId`)
		local foundation, anchor, entrance = part(model, "Foundation"), part(model, "Anchor"), part(model, "Entrance")
		assert(
			not anchor.CanCollide
				and anchor.Transparency == 1
				and not entrance.CanCollide
				and entrance.Transparency == 1,
			`Factory hub: Lot{id} anchors must be invisible/noncolliding`
		)
		local frame = anchor.CFrame
		assert(
			math.abs(frame.UpVector.Y - 1) &lt; 0.001 and foundation.CanCollide,
			`Factory hub: Lot{id} must be upright and supported`
		)
		local top = foundation.CFrame * CFrame.new(0, foundation.Size.Y / 2, 0)
		assert(
			(top.Position - frame.Position).Magnitude &lt; 0.01 and top.LookVector:Dot(frame.LookVector) &gt; 0.999,
			`Factory hub: Lot{id} Anchor must match foundation top frame`
		)
		local inward = Vector3.new(cache.Position.X - frame.Position.X, 0, cache.Position.Z - frame.Position.Z).Unit
		assert(frame.LookVector:Dot(inward) &gt; 0.999, `Factory hub: Lot{id} local -Z front must face the cache`)
		assert(
			(entrance.Position - frame:PointToWorldSpace(Vector3.new(0, 0, -foundation.Size.Z / 2))).Magnitude &lt; 0.01,
			`Factory hub: Lot{id} Entrance must mark front midpoint`
		)
		assert(
			foundation.Size.X &gt;= 40 and foundation.Size.Z &gt;= 50,
			`Factory hub: Lot{id} foundation too small for production zones`
		)
		if id &gt; 1 then
			assert(
				(foundation.Size - lots[1].foundation.Size).Magnitude &lt; 0.01,
				"Factory hub: unequal foundation sizes"
			)
		end
		local accent = model:GetAttribute("Accent")
		assert(typeof(accent) == "Color3", `Factory hub: Lot{id} requires a Color3 Accent`)
		lots[id] = { frame = frame, foundation = foundation, entrance = entrance, accent = accent }
		MapLayout.clear(entrance.CFrame * CFrame.new(0, 0, 3), Vector3.new(10, 7, 5), foundation, `Lot{id} entrance`)
	end
	for i = 1, #lots do
		for j = i + 1, #lots do
			assert(
				MapLayout.gap(lots[i], lots[j]) &gt; 1,
				`Factory hub: Lot{i}/Lot{j} footprints intersect or have no clearance`
			)
		end
	end
	return { root = root, lots = lots, cache = cache, plaza = plaza, spawn = spawn }
end

return MapLayout
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="CODE_ServerScriptService_9">
        <Properties>
          <string name="Name">PlotWorld</string>
          <string name="Source">--!strict

local Shared = game:GetService("ReplicatedStorage").TycoonShared
local Config = require(Shared.Config)
local Catalogue = require(Shared.UpgradeCatalogue)
local MapLayout = require(script.Parent.MapLayout)

export type Pad = { part: Part, prompt: ProximityPrompt, label: TextLabel }
export type Plot = {
	model: Model,
	pads: { [Catalogue.Id]: Pad },
	upgrades: Folder,
	label: TextLabel,
	frame: CFrame,
	color: Color3,
}
local PlotWorld = {}
-- Local geometry only. World positions/orientation come exclusively from saved anchors.
local layouts: { [Catalogue.Id]: { pad: Vector3, machine: Vector3 } } = {
	income_booster = { pad = Vector3.new(-10, 0, -15), machine = Vector3.new(-18, 0, -10) },
	booster_tuning = { pad = Vector3.new(-10, 0, 0), machine = Vector3.new(-18, 0, 5) },
	workshop = { pad = Vector3.new(10, 0, -15), machine = Vector3.new(18, 0, -10) },
	workshop_expansion = { pad = Vector3.new(10, 0, 0), machine = Vector3.new(18, 0, 5) },
}

local function block(parent: Instance, name: string, size: Vector3, frame: CFrame, color: Color3, solid: boolean?): Part
	local part = Instance.new("Part")
	part.Name, part.Size, part.CFrame, part.Color = name, size, frame, color
	part.Anchored = true
	part.CanCollide = solid == true
	part.CanTouch = false
	part.Material = Enum.Material.Metal
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function surfaceLabel(part: Part, face: Enum.NormalId): TextLabel
	local surface = Instance.new("SurfaceGui")
	surface.Name, surface.Face = "Label", face
	surface.CanvasSize = Vector2.new(420, 220)
	surface.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(235, 242, 247)
	label.Font, label.TextSize, label.TextWrapped = Enum.Font.GothamBold, 30, true
	label.Parent = surface
	return label
end

-- Anchored equipment silhouettes; only the base/housing collide. No moving products.
local function machine(parent: Instance, name: string, frame: CFrame, color: Color3, extended: boolean): Model
	local model = Instance.new("Model")
	model.Name, model.Parent = name, parent
	local steel = Color3.fromRGB(49, 60, 68)
	local height = if extended then 6 else 4
	block(model, "Base", Vector3.new(7, 0.5, 7), frame * CFrame.new(0, 0.25, 0), steel, true)
	for _, x in { -2.6, 2.6 } do
		block(model, "Support", Vector3.new(0.6, height, 0.7), frame * CFrame.new(x, height / 2 + 0.5, 2.3), steel)
	end
	local housing = block(model, "Housing", Vector3.new(5, 2.6, 3.5), frame * CFrame.new(0, height, 1), steel, true)
	block(model, "Hopper", Vector3.new(5.6, 0.7, 4), frame * CFrame.new(0, height + 1.6, 1), color)
	block(
		model,
		"Output",
		Vector3.new(2.2, 1, 2),
		frame * CFrame.new(0, height - 0.5, -1.5),
		Color3.fromRGB(137, 148, 154)
	)
	block(model, "WorkStation", Vector3.new(4.5, 0.4, 2), frame * CFrame.new(0, 1.3, -2), steel)
	block(
		model,
		"StatusLight",
		Vector3.new(0.6, 0.4, 0.12),
		frame * CFrame.new(1.7, height + 0.6, -0.81),
		Color3.fromRGB(145, 217, 187)
	).Material =
		Enum.Material.Neon
	surfaceLabel(housing, Enum.NormalId.Front).Text = if name == "Generator"
		then "STARTER UNIT\n+1 / sec"
		else Catalogue.ById[name :: Catalogue.Id].DisplayName
	if extended then
		block(model, "ControlCabinet", Vector3.new(1.5, 3, 2), frame * CFrame.new(2.3, 2, -0.5), color)
		block(
			model,
			"UpperPipe",
			Vector3.new(0.7, 3, 0.7),
			frame * CFrame.new(-1.8, height + 1, 1.5),
			Color3.fromRGB(142, 155, 166)
		)
	end
	return model
end

function PlotWorld.inspect(): MapLayout.Layout
	assert(
		not workspace:FindFirstChild(Config.RuntimeName),
		`Tycoon: reserved Workspace/{Config.RuntimeName} already exists`
	)
	local layout = MapLayout.inspect()
	for id, lot in layout.lots do
		MapLayout.clear(
			lot.frame * CFrame.new(-19, 0, -25),
			Vector3.new(8, 10, 8),
			lot.foundation,
			`Lot{id} starter machine`
		)
		for upgradeId, slot in layouts do
			MapLayout.clear(
				lot.frame * CFrame.new(slot.machine),
				Vector3.new(8, 11, 8),
				lot.foundation,
				`Lot{id}/{upgradeId} equipment`
			)
			MapLayout.clear(
				lot.frame * CFrame.new(slot.pad),
				Vector3.new(5, 7, 5),
				lot.foundation,
				`Lot{id}/{upgradeId} interaction`
			)
			assert(
				(lot.frame:PointToWorldSpace(slot.pad) - layout.cache.Position).Magnitude &gt; 10,
				`Lot{id}/{upgradeId} overlaps cache prompt range`
			)
		end
	end
	return layout
end

function PlotWorld.create(layout: MapLayout.Layout): { Plot }
	local folder = Instance.new("Folder")
	folder.Name, folder.Archivable = Config.RuntimeName, false
	local plots: { Plot } = {}
	for id, lot in layout.lots do
		local model = Instance.new("Model")
		model.Name = `Plot{id}`
		model:SetAttribute(Config.Attributes.PlotId, id)
		model.Parent = folder
		local upgrades = Instance.new("Folder")
		upgrades.Name, upgrades.Parent = "Upgrades", model
		machine(model, "Generator", lot.frame * CFrame.new(-19, 0, -25), lot.accent, false)
		local pads: { [Catalogue.Id]: Pad } = {}
		for _, definition in Catalogue.Definitions do
			local p = block(
				model,
				`Pad_{definition.Id}`,
				Vector3.new(4, 0.3, 3),
				lot.frame * CFrame.new(layouts[definition.Id].pad + Vector3.new(0, 0.15, 0)),
				Color3.fromRGB(90, 90, 90)
			)
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name, prompt.ObjectText = "Purchase", `{definition.DisplayName} (+{definition.IncomeDelta}/tick)`
			prompt.MaxActivationDistance = Config.PurchasePromptDistance
			prompt.RequiresLineOfSight, prompt.ClickablePrompt = false, true
			prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
			prompt.HoldDuration, prompt.Enabled, prompt.Parent = 0, false, p
			pads[definition.Id] = { part = p, prompt = prompt, label = surfaceLabel(p, Enum.NormalId.Top) }
		end
		local signPart =
			block(model, "OwnerPanel", Vector3.new(7, 2.5, 0.4), lot.frame * CFrame.new(23, 3, -30), lot.accent)
		local sign = Instance.new("BillboardGui")
		sign.Name, sign.Size = "Ownership", UDim2.fromOffset(130, 36)
		sign.StudsOffset = Vector3.new(0, 1.5, 0)
		-- Show nearby ownership without six large labels filling the plaza view.
		sign.AlwaysOnTop, sign.MaxDistance, sign.Parent = false, 90, signPart
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3, label.BackgroundTransparency = Color3.fromRGB(24, 28, 36), 0.25
		label.TextColor3, label.Font, label.TextSize = Color3.new(1, 1, 1), Enum.Font.GothamBold, 12
		label.TextWrapped, label.Parent = true, sign
		plots[id] =
			{ model = model, pads = pads, upgrades = upgrades, label = label, frame = lot.frame, color = lot.accent }
		PlotWorld.setOwner(plots[id], nil)
	end
	folder.Parent = workspace
	return plots
end

function PlotWorld.reconcile(plot: Plot, purchases: Catalogue.Purchases, cash: number)
	local owned = plot.model:GetAttribute(Config.Attributes.OwnerUserId) ~= nil
	for _, definition in Catalogue.Definitions do
		local id = definition.Id
		local purchased = purchases[id] == true
		local visual = plot.upgrades:FindFirstChild(id)
		if purchased and not visual then
			machine(
				plot.upgrades,
				id,
				plot.frame * CFrame.new(layouts[id].machine),
				plot.color,
				id == "booster_tuning" or id == "workshop_expansion"
			)
		elseif not purchased and visual then
			visual:Destroy()
		end
		plot.model:SetAttribute(Catalogue.purchaseAttribute(id), purchased)
		local pad = plot.pads[id]
		local availability = Catalogue.availability(definition, purchases, cash)
		local state = if owned then Catalogue.stateText(definition, purchases, cash) else "No owner"
		pad.label.Text = `{definition.DisplayName}\n{definition.Cost} cash • +{definition.IncomeDelta}/tick\n{state}`
		pad.prompt.ActionText = if availability == "affordable" then `Buy ({definition.Cost} cash)` else state
		pad.prompt.Enabled = owned and not purchased
		pad.part.Color = if not owned or availability == "locked"
			then Color3.fromRGB(86, 96, 105)
			elseif purchased then Color3.fromRGB(92, 186, 137)
			elseif availability == "affordable" then Color3.fromRGB(67, 158, 157)
			else Color3.fromRGB(192, 148, 62)
	end
end

function PlotWorld.setOwner(plot: Plot, player: Player?)
	plot.model:SetAttribute(Config.Attributes.OwnerUserId, if player then player.UserId else nil)
	plot.label.Text = `FACTORY {plot.model:GetAttribute(Config.Attributes.PlotId)}\n`
		.. (if player then player.DisplayName else "Available")
	PlotWorld.reconcile(plot, {}, 0)
end
return PlotWorld
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="CODE_ServerScriptService_10">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source">--!strict

-- Server-only session state. No Instances, player attributes, timers, or persistence.
local Catalogue = require(game:GetService("ReplicatedStorage").TycoonShared.UpgradeCatalogue)
export type Tuning = {
	read PlotCount: number,
	read StartingCash: number,
	read BaseIncome: number,
}

export type State = {
	userId: number,
	plotId: number,
	cash: number,
	incomeRate: number,
	purchases: Catalogue.Purchases,
}

local Session = {}
Session.__index = Session

type Data = {
	tuning: Tuning,
	definitions: { [string]: Catalogue.Definition },
	states: { [number]: State },
	owners: { [number]: number },
}
export type Session = typeof(setmetatable({} :: Data, Session))

function Session.new(tuning: Tuning, definitions: { Catalogue.Definition }): Session
	assert(tuning.PlotCount &gt; 0 and tuning.PlotCount % 1 == 0, "Tycoon: PlotCount must be a positive integer")
	assert(
		tuning.StartingCash &gt;= 0 and tuning.StartingCash % 1 == 0,
		"Tycoon: StartingCash must be a nonnegative integer"
	)
	assert(tuning.BaseIncome &gt; 0 and tuning.BaseIncome % 1 == 0, "Tycoon: BaseIncome must be a positive integer")
	local byId = Catalogue.validate(definitions)
	local snapshot = table.freeze({
		PlotCount = tuning.PlotCount,
		StartingCash = tuning.StartingCash,
		BaseIncome = tuning.BaseIncome,
	})
	return setmetatable({ tuning = snapshot, definitions = byId, states = {}, owners = {} }, Session)
end

function Session.get(self: Session, userId: number): State?
	return self.states[userId]
end

function Session.assign(self: Session, userId: number): State?
	local existing = self.states[userId]
	if existing then
		return existing
	end
	for plotId = 1, self.tuning.PlotCount do
		if self.owners[plotId] == nil then
			local state: State = {
				userId = userId,
				plotId = plotId,
				cash = self.tuning.StartingCash,
				incomeRate = self.tuning.BaseIncome,
				purchases = {},
			}
			self.owners[plotId] = userId
			self.states[userId] = state
			return state
		end
	end
	return nil -- Explicit full-capacity result; the adapter reports it to the player.
end

function Session.release(self: Session, userId: number): number?
	local state = self.states[userId]
	if not state then
		return nil
	end
	self.owners[state.plotId] = nil
	self.states[userId] = nil
	return state.plotId
end

function Session.assignedCount(self: Session): number
	local count = 0
	for _ in self.states do
		count += 1
	end
	return count
end

-- Server-only additive reward, with no yield, attribute writes, income or purchase effects.
-- Inactive/replaced owners cannot receive a credit. Amount is resolved by the event.
function Session.credit(self: Session, userId: number, amount: number): boolean
	assert(amount &gt; 0 and amount &lt; math.huge and amount % 1 == 0, "Tycoon: credit must be a finite positive integer")
	local state = self.states[userId]
	if not state or self.owners[state.plotId] ~= userId then
		return false
	end
	state.cash += amount
	return true
end

function Session.accrue(self: Session, ticks: number)
	assert(ticks &gt;= 0 and ticks % 1 == 0, "Tycoon: income ticks must be nonnegative integers")
	for _, state in self.states do
		state.cash += state.incomeRate * ticks
	end
end

-- No yields: eligibility, deduction, and application form one server transaction.
-- Returns accepted, reason, missing cash (zero for other results). IDs resolve on
-- the server; neither price nor effect is supplied by the caller.
function Session.purchase(
	self: Session,
	userId: number,
	plotId: number,
	upgradeId: string
): (boolean, Catalogue.PurchaseReason, number)
	local state = self.states[userId]
	if not state then
		return false, "inactive", 0
	end
	if state.plotId ~= plotId or self.owners[plotId] ~= userId then
		return false, "not-owner", 0
	end
	local definition = self.definitions[upgradeId]
	if not definition then
		return false, "unknown-upgrade", 0
	end
	local availability, missing = Catalogue.availability(definition, state.purchases, state.cash)
	if availability == "purchased" then
		return false, "already-purchased", 0
	end
	if availability == "locked" then
		return false, "locked", 0
	end
	if availability == "unaffordable" then
		return false, "insufficient-cash", missing
	end
	state.cash -= definition.Cost
	state.purchases[definition.Id] = true
	state.incomeRate += definition.IncomeDelta
	return true, "purchased", 0
end

return Session
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="CODE_ServerScriptService_11">
        <Properties>
          <string name="Name">SupplyEvent</string>
          <string name="Source">--!strict

-- Deadline state and the one atomic reward operation; no Instances or clock reads.
local Rules = require(game:GetService("ReplicatedStorage").TycoonShared.SupplyRules)
local Session = require(script.Parent.Session)

local SupplyEvent = {}
SupplyEvent.__index = SupplyEvent
type Data = {
	tuning: Rules.Tuning,
	serial: number,
	firstOpensAt: number?,
	index: number,
	opensAt: number,
	closesAt: number,
	resultUntil: number,
	winnerUserId: number?,
	winnerName: string?,
	lastNow: number,
	phase: Rules.Phase,
}
export type Event = typeof(setmetatable({} :: Data, SupplyEvent))
export type ClaimReason = "claimed" | "inactive" | "stale" | "closed" | "already-claimed"

function SupplyEvent.new(tuning: Rules.Tuning): Event
	return setmetatable({
		tuning = Rules.validate(tuning),
		serial = 0,
		firstOpensAt = nil,
		index = 0,
		opensAt = 0,
		closesAt = 0,
		resultUntil = 0,
		winnerUserId = nil,
		winnerName = nil,
		lastNow = 0,
		phase = "idle" :: Rules.Phase,
	}, SupplyEvent)
end

local function validTime(self: Event, now: number)
	assert(now &gt;= 0 and now &lt; math.huge, "Supply Cache: time must be finite and nonnegative")
	assert(now &gt;= self.lastNow, "Supply Cache: time must not move backwards")
	assert(now + self.tuning.Interval &gt; now, "Supply Cache: time is too large for deadlines")
end

function SupplyEvent.sync(self: Event, now: number, assignedCount: number)
	validTime(self, now)
	assert(assignedCount &gt;= 0 and assignedCount % 1 == 0, "Supply Cache: assigned count must be a nonnegative integer")
	self.lastNow = now
	if assignedCount == 0 then
		if self.firstOpensAt then
			self.serial += 1
		end -- Invalidate every old interaction, including pending ones.
		self.firstOpensAt = nil
		self.opensAt, self.closesAt, self.resultUntil = 0, 0, 0
		self.winnerUserId, self.winnerName = nil, nil
		self.phase = "idle"
		return
	end
	local first = self.firstOpensAt
	if not first then
		first = now + self.tuning.FirstDelay
		self.firstOpensAt = first
		self.index = 0
		self.serial += 1
		self.opensAt = first
		self.closesAt = first + self.tuning.Window
	end
	-- Jump directly to the current warning/window; never replay missed openings.
	assert(first, "Supply Cache: active schedule lacks its first deadline")
	local index = math.max(0, math.floor((now - first + self.tuning.Warning) / self.tuning.Interval))
	if index &gt; self.index then
		self.serial += index - self.index
		self.index = index
		self.opensAt = first + index * self.tuning.Interval
		self.closesAt = self.opensAt + self.tuning.Window
		self.resultUntil = 0
		self.winnerUserId, self.winnerName = nil, nil
	end
	if self.winnerUserId then
		self.phase = if now &lt; self.resultUntil then "result" else "waiting"
	elseif now &gt;= self.closesAt then
		self.resultUntil = self.closesAt + self.tuning.ResultDuration
		self.phase = if now &lt; self.resultUntil then "result" else "waiting"
	elseif now &gt;= self.opensAt then
		self.phase = "open"
	elseif now &gt;= self.opensAt - self.tuning.Warning then
		self.phase = "warning"
	else
		self.phase = "waiting"
	end
end

function SupplyEvent.snapshot(self: Event): Rules.Snapshot
	local nextOpening = if self.phase == "idle" then 0 else self.opensAt
	if self.phase ~= "idle" and (self.winnerUserId or self.lastNow &gt;= self.closesAt) then
		nextOpening += self.tuning.Interval
	end
	local deadline = if self.phase == "idle"
		then 0
		elseif self.phase == "open" then self.closesAt
		elseif self.phase == "result" then self.resultUntil
		else nextOpening
	return table.freeze({
		id = self.serial,
		phase = self.phase,
		opensAt = self.opensAt,
		closesAt = self.closesAt,
		nextOpensAt = nextOpening,
		deadline = deadline,
		reward = self.tuning.Reward,
		winnerUserId = if self.phase == "result" then self.winnerUserId else nil,
		winnerName = if self.phase == "result" then self.winnerName else nil,
	})
end

-- First valid request processed by the server wins; not local press order or latency compensation.
-- Credit and resolution cannot yield. A failed Session credit never consumes this event.
function SupplyEvent.claim(
	self: Event,
	session: Session.Session,
	userId: number,
	name: string,
	id: number,
	now: number
): (boolean, ClaimReason)
	validTime(self, now)
	if not session:get(userId) then
		return false, "inactive"
	end
	self:sync(now, session:assignedCount())
	if id ~= self.serial then
		return false, "stale"
	end
	if not self.firstOpensAt or now &lt; self.opensAt or now &gt;= self.closesAt then
		return false, "closed"
	end
	if self.winnerUserId then
		return false, "already-claimed"
	end
	if not session:credit(userId, self.tuning.Reward) then
		return false, "inactive"
	end
	self.winnerUserId, self.winnerName = userId, name
	self.resultUntil = now + self.tuning.ResultDuration
	self.phase = "result"
	return true, "claimed"
end

return SupplyEvent
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="CODE_ServerScriptService_12">
        <Properties>
          <string name="Name">SupplyRuntime</string>
          <string name="Source">--!strict

-- Roblox lifecycle/claim boundary and coherent current-state replication.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Rules = require(ReplicatedStorage.TycoonShared.SupplyRules)
local Session = require(script.Parent.Session)
local SupplyEvent = require(script.Parent.SupplyEvent)
local SupplyWorld = require(script.Parent.SupplyWorld)

local SupplyRuntime = {}
SupplyRuntime.__index = SupplyRuntime
type Data = {
	session: Session.Session,
	active: { [number]: Player },
	publish: (Player, Session.State) -&gt; (),
	event: SupplyEvent.Event,
	world: SupplyWorld.World,
	state: StringValue,
	feedback: RemoteEvent,
	nextRequest: { [number]: number },
	prompt: ProximityPrompt?,
	promptId: number?,
}
export type Runtime = typeof(setmetatable({} :: Data, SupplyRuntime))

function SupplyRuntime.inspect(): Vector3
	for _, name in { Rules.StateName, Rules.FeedbackName } do
		assert(not ReplicatedStorage:FindFirstChild(name), `Supply Cache: reserved ReplicatedStorage/{name} exists`)
	end
	return SupplyWorld.inspect()
end

function SupplyRuntime.new(
	session: Session.Session,
	active: { [number]: Player },
	publish: (Player, Session.State) -&gt; (),
	parent: Instance,
	center: Vector3
): Runtime
	local event = SupplyEvent.new(Rules.Tuning)
	local world = SupplyWorld.create(parent, center)
	SupplyWorld.render(world, event:snapshot())
	local state = Instance.new("StringValue")
	state.Name = Rules.StateName
	state.Archivable = false
	state:SetAttribute("Position", world.cache.Position)
	state.Value = HttpService:JSONEncode(event:snapshot())
	state.Parent = ReplicatedStorage
	local feedback = Instance.new("RemoteEvent")
	feedback.Name = Rules.FeedbackName
	feedback.Archivable = false
	feedback.Parent = ReplicatedStorage
	local self: Runtime = setmetatable({
		session = session,
		active = active,
		publish = publish,
		event = event,
		world = world,
		state = state,
		feedback = feedback,
		nextRequest = {},
	}, SupplyRuntime)
	self:sync(workspace:GetServerTimeNow())
	return self
end

function SupplyRuntime.sync(self: Runtime, now: number)
	self.event:sync(now, self.session:assignedCount())
	local snapshot = self.event:snapshot()
	if self.promptId ~= snapshot.id then
		if self.prompt then
			self.prompt:Destroy()
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Claim"
		prompt.ObjectText = "Shared Supply Cache"
		prompt.ActionText = `Claim +{snapshot.reward} cash`
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = Rules.Tuning.Radius
		prompt.RequiresLineOfSight = false
		prompt.ClickablePrompt = true
		prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
		prompt.Enabled = false
		prompt:SetAttribute("EventId", snapshot.id)
		prompt.Parent = self.world.cache
		local boundId = snapshot.id -- Captured on the server, never read back from client attributes.
		prompt.Triggered:Connect(function(player: Player)
			self:claim(player, boundId)
		end)
		self.prompt, self.promptId = prompt, boundId
	end
	local prompt = self.prompt
	assert(prompt, "Supply Cache: missing claim prompt")
	prompt.Enabled = snapshot.phase == "open"
	local encoded = HttpService:JSONEncode(snapshot)
	if self.state.Value ~= encoded then
		self.state.Value = encoded -- One atomic value: subscribers cannot read a half-written snapshot.
		SupplyWorld.render(self.world, snapshot)
	end
end

function SupplyRuntime.leave(self: Runtime, player: Player)
	self.nextRequest[player.UserId] = nil
	self:sync(workspace:GetServerTimeNow())
end

function SupplyRuntime.claim(self: Runtime, player: Player, boundId: number)
	if player.Parent ~= Players or self.active[player.UserId] ~= player then
		return
	end
	local requestTime = os.clock()
	if requestTime &lt; (self.nextRequest[player.UserId] or 0) then
		return
	end
	self.nextRequest[player.UserId] = requestTime + Rules.Tuning.RequestInterval
	local now = workspace:GetServerTimeNow()
	self:sync(now)
	local message: string
	local state = self.session:get(player.UserId)
	if not state then
		message = "A plot is needed to claim"
	else
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		local humanoid = if character then character:FindFirstChildWhichIsA("Humanoid") else nil
		if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then
			message = "Respawn before claiming"
		elseif (root.Position - self.world.cache.Position).Magnitude &gt; Rules.Tuning.Radius then
			message = "Move closer to the cache"
		else
			local accepted, reason = self.event:claim(self.session, player.UserId, player.DisplayName, boundId, now)
			if accepted then
				self.publish(player, state)
				message = `Claimed +{Rules.Tuning.Reward} cash`
			else
				message = if reason == "stale"
					then "Cache changed — try the current event"
					elseif reason == "already-claimed" then "Already claimed"
					elseif reason == "inactive" then "A plot is needed to claim"
					else "Cache is closed"
			end
		end
	end
	self:sync(now)
	-- Separate from the purchase-only remote and its limiter. No client-to-server handler.
	self.feedback:FireClient(player, self.event:snapshot().id, message)
end

return SupplyRuntime
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="CODE_ServerScriptService_13">
        <Properties>
          <string name="Name">SupplyWorld</string>
          <string name="Source">--!strict

-- The inspected neutral footprint and primitive marker; no economy or scheduling.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Rules = require(ReplicatedStorage.TycoonShared.SupplyRules)

local SupplyWorld = {}
export type World = { model: Model, cache: Part, label: TextLabel }

local MapLayout = require(script.Parent.MapLayout)

function SupplyWorld.inspect(): Vector3
	return MapLayout.inspect().cache.Position
end

local function block(parent: Instance, name: string, size: Vector3, position: Vector3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Anchored = true
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.fromRGB(105, 114, 129)
	part.Parent = parent
	return part
end

function SupplyWorld.create(parent: Instance, center: Vector3): World
	assert(
		not parent:FindFirstChild(Rules.WorldName),
		`Supply Cache: reserved {parent:GetFullName()}/{Rules.WorldName} exists`
	)
	-- Inspect the actual purchase-pad geometry, rather than duplicating its offsets.
	for _, instance in parent:GetDescendants() do
		if instance:IsA("ProximityPrompt") then
			local part = instance.Parent
			assert(part and part:IsA("BasePart"), "Supply Cache: purchase prompt must have a part")
			assert(
				(part.Position - (center + Vector3.new(0, 1.1, 0))).Magnitude
					&gt; Rules.Tuning.Radius + instance.MaxActivationDistance,
				`Supply Cache: claim range overlaps purchase prompt {instance:GetFullName()}`
			)
		end
	end
	local model = Instance.new("Model")
	model.Name = Rules.WorldName
	model.Archivable = false
	local floor = block(model, "Floor", Vector3.new(6, 0.1, 6), center + Vector3.new(0, 0.05, 0))
	floor.Color = Color3.fromRGB(105, 114, 129)
	local cache = block(model, "Cache", Vector3.new(3, 2, 3), center + Vector3.new(0, 1.1, 0))
	local marker = Instance.new("BillboardGui")
	marker.Name = "SharedMarker"
	marker.Size = UDim2.fromOffset(180, 48)
	marker.StudsOffset = Vector3.new(0, 5, 0)
	marker.AlwaysOnTop = false
	marker.MaxDistance = 100
	marker.Parent = cache
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(24, 28, 36)
	label.BackgroundTransparency = 0.1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.TextWrapped = true
	label.Parent = marker
	model.Parent = parent
	return { model = model, cache = cache, label = label }
end

function SupplyWorld.render(world: World, state: Rules.Snapshot)
	local hint = if state.phase == "open"
		then "CLAIM NOW"
		elseif state.phase == "warning" then "Opening soon"
		elseif state.phase == "result" then (if state.winnerName
			then `{state.winnerName} claimed it`
			else "Expired — nobody claimed")
		elseif state.phase == "idle" then "Waiting for a plot owner"
		else "Next opening scheduled"
	world.label.Text = `Shared Supply Cache • +{state.reward} cash\n{hint}`
	world.cache.Color = if state.phase == "open"
		then Color3.fromRGB(85, 225, 220)
		elseif state.phase == "warning" then Color3.fromRGB(255, 218, 91)
		elseif state.phase == "result" and state.winnerName then Color3.fromRGB(92, 232, 117)
		else Color3.fromRGB(130, 130, 140)
end

return SupplyWorld
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="CODE_ServerScriptService_14">
        <Properties>
          <string name="Name">TycoonRuntime</string>
          <string name="Source">--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.TycoonShared.Config)
local Catalogue = require(ReplicatedStorage.TycoonShared.UpgradeCatalogue)
local Session = require(script.Parent.Session)
local PlotWorld = require(script.Parent.PlotWorld)
local SupplyRuntime = require(script.Parent.SupplyRuntime)

local TycoonRuntime = {}
local started = false

function TycoonRuntime.start()
	assert(RunService:IsServer(), "Tycoon: runtime must start on the server")
	assert(not started, "Tycoon: runtime started twice")
	local numbers: { [string]: number } = {
		IncomeInterval = Config.IncomeInterval,
		PromptDistance = Config.PromptDistance,
		PurchasePromptDistance = Config.PurchasePromptDistance,
		RequestInterval = Config.RequestInterval,
		FeedbackDuration = Config.FeedbackDuration,
	}
	for field, value in numbers do
		assert(value &gt; 0 and value &lt; math.huge, `Tycoon: {field} must be finite and positive`)
	end
	assert(
		Config.PurchasePromptDistance &lt;= Config.PromptDistance,
		"Tycoon: display distance exceeds server purchase distance"
	)
	assert(
		not ReplicatedStorage:FindFirstChild(Config.FeedbackName),
		`Tycoon: reserved ReplicatedStorage/{Config.FeedbackName} already exists`
	)
	-- Pass a typed value snapshot; shared Config is frozen and remains presentation-safe.
	local tuning: Session.Tuning = {
		PlotCount = Config.PlotCount,
		StartingCash = Config.StartingCash,
		BaseIncome = Config.BaseIncome,
	}
	local session = Session.new(tuning, Catalogue.Definitions)
	local layout = PlotWorld.inspect() -- All authored geometry is validated before writes.
	local supplyCenter = SupplyRuntime.inspect()
	local plots = PlotWorld.create(layout)
	-- Outbound only: no client purchase remote, message forwarding, or broadcast.
	local feedback = Instance.new("RemoteEvent")
	feedback.Name = Config.FeedbackName
	feedback.Archivable = false
	feedback.Parent = ReplicatedStorage
	local active: { [number]: Player } = {}
	local nextRequest: { [number]: number } = {}
	started = true

	local function publish(player: Player, state: Session.State)
		for _, definition in Catalogue.Definitions do
			player:SetAttribute(Catalogue.purchaseAttribute(definition.Id), state.purchases[definition.Id] == true)
		end
		player:SetAttribute(Config.Attributes.Cash, state.cash)
		player:SetAttribute(Config.Attributes.IncomeRate, state.incomeRate)
		player:SetAttribute(Config.Attributes.PlotId, state.plotId)
		player:SetAttribute(Config.Attributes.Assignment, "Assigned")
		PlotWorld.reconcile(plots[state.plotId], state.purchases, state.cash)
	end

	local function clear(player: Player)
		player:SetAttribute(Config.Attributes.Assignment, nil)
		for _, definition in Catalogue.Definitions do
			player:SetAttribute(Catalogue.purchaseAttribute(definition.Id), nil)
		end
		player:SetAttribute(Config.Attributes.Cash, nil)
		player:SetAttribute(Config.Attributes.IncomeRate, nil)
		player:SetAttribute(Config.Attributes.PlotId, nil)
	end
	local runtimeFolder = workspace:FindFirstChild(Config.RuntimeName)
	assert(runtimeFolder, "Tycoon: runtime geometry is missing")
	local supply = SupplyRuntime.new(session, active, publish, runtimeFolder, supplyCenter)

	local function join(player: Player)
		if player.Parent ~= Players or active[player.UserId] == player then
			return
		end
		assert(active[player.UserId] == nil, `Tycoon: duplicate active user {player.UserId}`)
		clear(player)
		active[player.UserId] = player
		local state = session:assign(player.UserId)
		if not state then
			player:SetAttribute(Config.Attributes.Assignment, "Full")
			warn(
				`[roblox_tycoon] No free plot for {player.Name} ({player.UserId}); all {Config.PlotCount} plots are occupied.`
			)
			return
		end
		PlotWorld.setOwner(plots[state.plotId], player)
		publish(player, state)
		supply:sync(workspace:GetServerTimeNow())
	end

	local function leave(player: Player)
		nextRequest[player.UserId] = nil
		if active[player.UserId] == player then
			active[player.UserId] = nil
			local id = session:release(player.UserId)
			if id then
				PlotWorld.setOwner(plots[id], nil)
			end
		end
		clear(player)
		supply:leave(player)
	end

	local function sendResult(player: Player, message: string)
		local state = session:get(player.UserId)
		feedback:FireClient(player, if state then state.plotId else nil, message)
	end

	for plotId, plot in plots do
		for upgradeId, pad in plot.pads do
			pad.prompt.Triggered:Connect(function(player: Player)
				-- Attributes and prompt visibility are presentation, never eligibility inputs.
				if player.Parent ~= Players or active[player.UserId] ~= player then
					return
				end
				-- Bound both processing and private result messages to four attempts/sec.
				-- Excess attempts are dropped; balance/ownership checks still decide purchases.
				local now = os.clock()
				if now &lt; (nextRequest[player.UserId] or 0) then
					return
				end
				nextRequest[player.UserId] = now + Config.RequestInterval
				local character = player.Character
				local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
				local humanoid = if character then character:FindFirstChildWhichIsA("Humanoid") else nil
				if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then
					sendResult(player, "Respawn before buying")
					return
				end
				if (root.Position - pad.part.Position).Magnitude &gt; Config.PromptDistance then
					sendResult(player, "Move closer to the pad")
					return
				end
				local accepted, reason, missing = session:purchase(player.UserId, plotId, upgradeId)
				if accepted then
					local state = session:get(player.UserId)
					assert(state, "Tycoon: purchased assignment disappeared")
					publish(player, state)
				end
				sendResult(player, Catalogue.resultMessage(upgradeId, reason, missing))
			end)
		end
	end
	Players.PlayerAdded:Connect(join)
	Players.PlayerRemoving:Connect(leave)
	for _, player in Players:GetPlayers() do
		join(player)
	end

	-- One shared clock; accrue completed intervals, including elapsed time after a stall.
	-- Joining players enter this server-wide cadence (first tick may be less than 1s away).
	local elapsed = 0
	RunService.Heartbeat:Connect(function(delta: number)
		supply:sync(workspace:GetServerTimeNow())
		elapsed += delta
		local ticks = math.floor(elapsed / Config.IncomeInterval)
		if ticks == 0 then
			return
		end
		elapsed -= ticks * Config.IncomeInterval
		session:accrue(ticks)
		for userId, player in active do
			local state = session:get(userId)
			if state then
				publish(player, state)
			end -- Full-capacity players have no economy.
		end
	end)
end

return TycoonRuntime
</string>
        </Properties>
      </Item>
    </Item>
